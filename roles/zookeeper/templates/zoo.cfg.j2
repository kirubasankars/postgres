# Generated by Ansible — three-node ZooKeeper ensemble.
tickTime={{ zookeeper_tick_time }}
initLimit={{ zookeeper_init_limit }}
syncLimit={{ zookeeper_sync_limit }}
dataDir={{ zookeeper_data_dir }}
dataLogDir={{ zookeeper_log_dir }}
clientPort={{ zookeeper_client_port }}
maxClientCnxns=60
autopurge.snapRetainCount={{ zookeeper_autopurge_snap_retain }}
autopurge.purgeInterval={{ zookeeper_autopurge_interval }}
4lw.commands.whitelist=srvr,ruok,stat,mntr,conf
standaloneEnabled=false
reconfigEnabled=false

{% for node in cluster_nodes %}
server.{{ node.zk_id }}={{ node.name }}:{{ zookeeper_peer_port }}:{{ zookeeper_election_port }}
{% endfor %}
